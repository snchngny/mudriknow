{
  "$schema": "https://unpkg.com/wrangler/config-schema.json",
  "name": "mudriknow-manual-intake",
  "main": "index.ts",
  "compatibility_date": "2026-10-18",
  "workers_dev": true,
  "observability": { "enabled": false },
  "vars": {
    "ALLOWED_MANUAL_HOSTS": "www.7-zip.org,7-zip.org,npp-user-manual.org,support.mozilla.org,support.apple.com,docs.blender.org,docs.videolan.me"
  },
  "ratelimits": [{ "name": "SUBMISSION_LIMIT", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } }],
  "durable_objects": { "bindings": [{ "name": "MANUAL_QUEUE", "class_name": "ManualQueue" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ManualQueue"] }]
}
